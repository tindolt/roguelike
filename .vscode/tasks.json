{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build roguelike",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Engine.cpp",
                "${workspaceFolder}/src/Actor.cpp",
                "${workspaceFolder}/src/Map.cpp",
                "-o",
                "${workspaceFolder}/roguelike",
                "-I/usr/local/include",
                "-L/usr/local/lib",
                "-ltcod",
                "-lSDL3",
                "-lutf8proc",
                "-llodepng-c",
                "-lz"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build roguelike with libtcod 2.2.2"
        },
        {
            "type": "shell",
            "label": "C/C++: mingw cross-compile roguelike (Windows)",
            "command": "x86_64-w64-mingw32-g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Engine.cpp",
                "${workspaceFolder}/src/Actor.cpp",
                "${workspaceFolder}/src/Map.cpp",
                "-o",
                "${workspaceFolder}/roguelike.exe",
                // Windows libtcod headers (platform-neutral, reuse the Linux ones)
                "-I/usr/local/include",
                // Windows .dll.a import libs in ${workspaceFolder}/lib/
                "-L${workspaceFolder}/lib",
                "-ltcod",
                "-lSDL3",
                "-lutf8proc",
                "-lz",
                // Required on Windows MinGW builds
                "-lmingw32",
                "-mwindows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Cross-compile for Windows using MinGW. Requires Windows .a libs in lib/"
        }
    ],
    "version": "2.0.0"
}