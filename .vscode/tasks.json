{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build Tollmark",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Engine.cpp",
                "${workspaceFolder}/src/Actor.cpp",
                "${workspaceFolder}/src/Map.cpp",
                "-o",
                "${workspaceFolder}/Tollmark",
                "-isystem", "/usr/local/include",
                "-L/usr/local/lib",
                "-ltcod",
                "-lSDL3",
                "-lutf8proc",
                "-llodepng-c",
                "-lz"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build roguelike with libtcod 2.2.2"
        },
        {
            "type": "shell",
            "label": "C/C++: mingw cross-compile roguelike (Windows)",
            "command": "x86_64-w64-mingw32-g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                // Required: tell libtcod headers we're linking a static archive (no dllimport)
                "-DLIBTCOD_STATIC",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Engine.cpp",
                "${workspaceFolder}/src/Actor.cpp",
                "${workspaceFolder}/src/Map.cpp",
                "-o",
                "${workspaceFolder}/Tollmark.exe",
                // Headers from setup-windows-deps.sh (SDL3 + libtcod for Windows)
                "-isystem", "${workspaceFolder}/.windows-include",
                // Static libtcod + SDL3 import lib built by setup-windows-deps.sh
                "-L${workspaceFolder}/lib",
                "-ltcod",
                "-llodepng-c",
                "-lSDL3",
                "-lz",
                // Required on Windows MinGW builds
                "-lmingw32",
                "-mwindows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Cross-compile for Windows using MinGW. Run setup-windows-deps.sh first."
        }
    ],
    "version": "2.0.0"
}